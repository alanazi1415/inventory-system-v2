# ============================================
# Security Environment Variables
# متغيرات البيئة الأمنية
# ============================================

# Database URL (Required)
# رابط قاعدة البيانات (مطلوب)
DATABASE_URL="postgresql://username:password@host:5432/database?sslmode=require"

# ============================================
# Authentication Settings
# إعدادات المصادقة
# ============================================

# Admin Password (Required in production)
# كلمة مرور الأدمن (مطلوبة في الإنتاج)
# ⚠️ IMPORTANT: Set a strong password with at least 12 characters
# ⚠️ مهم: عيّن كلمة مرور قوية بطول 12 حرف على الأقل
ADMIN_PASSWORD="your-secure-admin-password-here"

# ============================================
# Encryption Keys (Required in production)
# مفاتيح التشفير (مطلوبة في الإنتاج)
# ============================================

# Encryption Key for sensitive data (32 bytes in hex format)
# مفتاح التشفير للبيانات الحساسة (32 بايت بصيغة hex)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="your-32-byte-encryption-key-in-hex-format"

# HMAC Secret for data integrity
# سر HMAC لسلامة البيانات
HMAC_SECRET="your-hmac-secret-key-here"

# Hash Salt for one-way hashing
# ملح التجزئة للتجزئة أحادية الاتجاه
HASH_SALT="your-hash-salt-here"

# ============================================
# Session Settings
# إعدادات الجلسة
# ============================================

# Session duration in hours (default: 24)
# مدة الجلسة بالساعات (افتراضي: 24)
SESSION_DURATION_HOURS=24

# ============================================
# Security Settings
# إعدادات الأمان
# ============================================

# Environment (development, staging, production)
# البيئة
NODE_ENV=production

# Allow iframes embedding (default: false for security)
# السماح بتضمين iframes (افتراضي: false للأمان)
ALLOW_IFRAME=false

# Enable debug mode (only in development)
# تفعيل وضع التصحيح (فقط في التطوير)
DEBUG=false

# ============================================
# Rate Limiting
# تحديد معدل الطلبات
# ============================================

# Max requests per minute (default: 100)
# الحد الأقصى للطلبات في الدقيقة
RATE_LIMIT_MAX=100

# Block duration in seconds (default: 60)
# مدة الحظر بالثواني
RATE_LIMIT_BLOCK_DURATION=60

# ============================================
# Logging
# التسجيل
# ============================================

# Log level (debug, info, warn, error)
# مستوى التسجيل
LOG_LEVEL=info

# Enable audit logging (default: true)
# تفعيل تسجيل التدقيق
ENABLE_AUDIT_LOG=true

# ============================================
# Optional: External Services
# اختياري: خدمات خارجية
# ============================================

# Sentry DSN for error tracking (optional)
# Sentry DSN لتتبع الأخطاء (اختياري)
# SENTRY_DSN="your-sentry-dsn-here"

# ============================================
# Development Only (Do not use in production!)
# للتطوير فقط (لا تستخدم في الإنتاج!)
# ============================================

# Skip authentication (development only)
# تخطي المصادقة (للتطوير فقط)
# SKIP_AUTH=false

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model InventoryItem {
  id                      String   @id @default(cuid())
  system                  String
  genericItemNumber       String?
  genericItemDescription  String?
  tradeItemNumber         String?
  customerItemNumber      String?
  totalQty                Float    @default(0)
  holdQty                 Float    @default(0)
  availableQty            Float    @default(0)
  expiryDate              String?
  daysToExpire            Float    @default(0)
  hold                    String?
  holdType                String?
  isLifeSaving            Boolean  @default(false)
  isNarcotic              Boolean  @default(false)
  isVaccine               Boolean  @default(false)
  isStrategic             Boolean  @default(false)
  isSmoking               Boolean  @default(false)
  isKidney                Boolean  @default(false)
  isCentral               Boolean  @default(false)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([system])
  @@index([daysToExpire])
  @@index([genericItemNumber])
  @@index([customerItemNumber])
  @@index([tradeItemNumber])
}

model LifeSavingItem {
  id          String   @id @default(cuid())
  itemNumber  String
  createdAt   DateTime @default(now())
  
  @@index([itemNumber])
}

model NarcoticItem {
  id          String   @id @default(cuid())
  itemNumber  String
  createdAt   DateTime @default(now())
  
  @@index([itemNumber])
}

model VaccineItem {
  id          String   @id @default(cuid())
  itemNumber  String
  createdAt   DateTime @default(now())
  
  @@index([itemNumber])
}

model StrategicItem {
  id          String   @id @default(cuid())
  itemNumber  String
  createdAt   DateTime @default(now())
  
  @@index([itemNumber])
}

model SmokingItem {
  id          String   @id @default(cuid())
  itemNumber  String
  createdAt   DateTime @default(now())
  
  @@index([itemNumber])
}

model KidneyItem {
  id          String   @id @default(cuid())
  itemNumber  String
  createdAt   DateTime @default(now())
  
  @@index([itemNumber])
}

model CentralItem {
  id          String   @id @default(cuid())
  itemNumber  String
  createdAt   DateTime @default(now())
  
  @@index([itemNumber])
}

model VisitorLog {
  id        String   @id @default(cuid())
  page      String
  system    String?
  createdAt DateTime @default(now())
  
  @@index([createdAt])
}

model UploadLog {
  id           String   @id @default(cuid())
  fileName     String
  system       String
  recordsCount Int      @default(0)
  createdAt    DateTime @default(now())
}

model AdminSession {
  id        String   @id @default(cuid())
  token     String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime
}

model AdminPassword {
  id        String   @id
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id                String   @id @default(cuid())
  username          String   @unique
  password          String
  name              String
  isActive          Boolean  @default(true)
  canViewInventory    Boolean @default(true)
  canViewAlerts       Boolean @default(true)
  canViewExpiring     Boolean @default(true)
  canViewExpired      Boolean @default(true)
  canViewLifeSaving   Boolean @default(true)
  canViewVaccines     Boolean @default(true)
  canViewStrategic    Boolean @default(true)
  canViewSmoking      Boolean @default(true)
  canViewKidney       Boolean @default(true)
  canViewCentral      Boolean @default(true)
  canViewReports      Boolean @default(true)
  canViewMovement     Boolean @default(true)
  canViewHoz          Boolean @default(true)
  canViewMwsal        Boolean @default(true)
  // صلاحيات تحليل الحركة
  canEditMovementSettings  Boolean @default(false) // تعديل إعدادات التصنيف
  canViewTopUp             Boolean @default(true)  // عرض اقتراحات التغذية
  canCalculateTopUp        Boolean @default(false) // حساب اقتراحات التغذية
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  sessions          UserSession[]

  @@index([username])
}

model UserSession {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([token])
  @@index([userId])
}

// نموذج حركة البنود
model ItemMovement {
  id                String   @id @default(cuid())
  genericItemNumber String   // رقم البند الرئيسي
  description       String?  // وصف البند
  system            String   // المستودع (hoz, mwsal)
  
  // إحصائيات الحركة
  totalQtyDispatched Float   @default(0)  // إجمالي الكمية المصروفة
  transactionCount   Int     @default(0)  // عدد المعاملات
  avgQtyPerTransaction Float @default(0)  // متوسط الكمية لكل معاملة
  
  // التواريخ
  firstDispatchDate  DateTime? // أول صرف
  lastDispatchDate   DateTime? // آخر صرف
  daysSpan           Int       @default(0) // عدد الأيام بين أول وآخر صرف
  
  // التصنيف
  movementClass      String   @default("غير مصنف") // سريع جداً، سريع، متوسط، بطيء، عديم الحركة
  movementScore      Float    @default(0) // درجة الحركة (للترتيب)
  
  // معلومات إضافية
  lastAnalysisDate   DateTime @default(now()) // تاريخ آخر تحليل
  reportSource       String?  // مصدر التقرير
  
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([genericItemNumber])
  @@index([system])
  @@index([movementClass])
  @@unique([genericItemNumber, system])
}

// سجل تقارير الحركة المحملة
model MovementReportLog {
  id           String   @id @default(cuid())
  fileName     String
  system       String
  recordsCount Int      @default(0)
  itemsCount   Int      @default(0)
  dateFrom     DateTime?
  dateTo       DateTime?
  createdAt    DateTime @default(now())
}

// إعدادات حدود تصنيف الحركة (قابلة للتخصيص من المستخدم)
model MovementThresholds {
  id                    String   @id @default(cuid())
  system                String   @unique // المستودع (hoz, mwsal)
  
  // حدود "سريع جداً"
  veryFastMinTransactions Int    @default(50)
  veryFastMinQty          Int    @default(5000)
  
  // حدود "سريع"
  fastMinTransactions     Int    @default(20)
  fastMinQty              Int    @default(2000)
  
  // حدود "متوسط"
  mediumMinTransactions   Int    @default(10)
  mediumMinQty            Int    @default(500)
  
  // حدود "بطيء"
  slowMinTransactions     Int    @default(3)
  
  // إعدادات TOP UP
  topUpDaysToAnalyze      Int    @default(90)   // عدد الأيام للتحليل
  topUpSafetyFactor       Float  @default(1.5)  // معامل الأمان
  topUpMinStockDays       Int    @default(30)   // الحد الأدنى لأيام المخزون
  
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

// اقتراحات تغذية المستودع (TOP UP)
model TopUpSuggestion {
  id                  String   @id @default(cuid())
  genericItemNumber   String
  description         String?
  system              String
  
  // المخزون الحالي
  currentStock        Float    @default(0)
  availableStock      Float    @default(0)
  
  // إحصائيات الصرف
  avgDailyConsumption Float    @default(0)  // متوسط الاستهلاك اليومي
  daysOfStock         Float    @default(0)  // أيام المخزون المتبقية
  
  // الاقتراح
  suggestedQty        Float    @default(0)  // الكمية المقترحة للتغذية
  urgencyLevel        String   @default("متوسط") // حرج، عالي، متوسط، منخفض
  
  // الحسابات
  calculationDate     DateTime @default(now())
  analysisPeriodDays  Int      @default(90)
  
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([genericItemNumber])
  @@index([system])
  @@index([urgencyLevel])
  @@unique([genericItemNumber, system])
}

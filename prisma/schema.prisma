generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model InventoryItem {
  id                      String   @id @default(cuid())
  system                  String
  genericItemNumber       String?
  genericItemDescription  String?
  tradeItemNumber         String?
  customerItemNumber      String?
  totalQty                Float    @default(0)
  holdQty                 Float    @default(0)
  availableQty            Float    @default(0)
  expiryDate              String?
  daysToExpire            Float    @default(0)
  hold                    String?
  holdType                String?
  isLifeSaving            Boolean  @default(false)
  isNarcotic              Boolean  @default(false)
  isVaccine               Boolean  @default(false)
  isStrategic             Boolean  @default(false)
  isSmoking               Boolean  @default(false)
  isKidney                Boolean  @default(false)
  isCentral               Boolean  @default(false)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([system])
  @@index([daysToExpire])
  @@index([genericItemNumber])
  @@index([customerItemNumber])
  @@index([tradeItemNumber])
}

model LifeSavingItem {
  id          String   @id @default(cuid())
  itemNumber  String
  createdAt   DateTime @default(now())
  
  @@index([itemNumber])
}

model NarcoticItem {
  id          String   @id @default(cuid())
  itemNumber  String
  createdAt   DateTime @default(now())
  
  @@index([itemNumber])
}

model VaccineItem {
  id          String   @id @default(cuid())
  itemNumber  String
  createdAt   DateTime @default(now())
  
  @@index([itemNumber])
}

model StrategicItem {
  id          String   @id @default(cuid())
  itemNumber  String
  createdAt   DateTime @default(now())
  
  @@index([itemNumber])
}

model SmokingItem {
  id          String   @id @default(cuid())
  itemNumber  String
  createdAt   DateTime @default(now())
  
  @@index([itemNumber])
}

model KidneyItem {
  id          String   @id @default(cuid())
  itemNumber  String
  createdAt   DateTime @default(now())
  
  @@index([itemNumber])
}

model CentralItem {
  id          String   @id @default(cuid())
  itemNumber  String
  createdAt   DateTime @default(now())
  
  @@index([itemNumber])
}

model VisitorLog {
  id        String   @id @default(cuid())
  page      String
  system    String?
  createdAt DateTime @default(now())
  
  @@index([createdAt])
}

model UploadLog {
  id           String   @id @default(cuid())
  fileName     String
  system       String
  recordsCount Int      @default(0)
  createdAt    DateTime @default(now())
}

model AdminSession {
  id        String   @id @default(cuid())
  token     String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime
}

model AdminPassword {
  id        String   @id
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id                String   @id @default(cuid())
  username          String   @unique
  password          String
  name              String
  isActive          Boolean  @default(true)
  canViewInventory    Boolean @default(true)
  canViewAlerts       Boolean @default(true)
  canViewExpiring     Boolean @default(true)
  canViewExpired      Boolean @default(true)
  canViewLifeSaving   Boolean @default(true)
  canViewVaccines     Boolean @default(true)
  canViewStrategic    Boolean @default(true)
  canViewSmoking      Boolean @default(true)
  canViewKidney       Boolean @default(true)
  canViewCentral      Boolean @default(true)
  canViewReports      Boolean @default(true)
  canViewHoz          Boolean @default(true)
  canViewMwsal        Boolean @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  sessions          UserSession[]

  @@index([username])
}

model UserSession {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([token])
  @@index([userId])
}
